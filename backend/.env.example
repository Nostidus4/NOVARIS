# Copy file này thành backend/.env rồi điền giá trị thật — không commit .env.
# Lấy giá trị thật tại Supabase Dashboard → Project Settings → API Keys.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# supabase (mặc định): GET /workflow/summary đọc DB trước, fallback file
# file: luôn đọc artifact trên đĩa
QSHIELD_WORKFLOW_STORE=supabase

# Origin thêm cho CORS (comma-separated). Mặc định đã gồm localhost:3000
# và https://nostidus4.github.io — chỉ cần khi custom domain Pages.
# QSHIELD_CORS_ORIGINS=https://your-custom-domain.com
