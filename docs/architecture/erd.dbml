// Q-SHIELD — ERD xuất từ packages/contracts/src/qshield_contracts/schemas/*.py
// Paste trực tiếp vào https://dbdiagram.io (File > Import > DBML, hoặc dán vào editor).
//
// 3 bảng đầu (returns, market_features, eligibility_daily) khớp CỘT THẬT đã chạy trên dữ liệu thật
// (packages/data). Các bảng còn lại (regime_daily, scenario_run, baseline_risk, action*, qaoa_*) là
// SPEC ĐI TRƯỚC — packages/ai, risk, quantum còn là scaffold, cột có thể đổi khi code thật xong.
// Sửa lại schemas/*.py trước, rồi generate lại DBML này — đừng sửa tay DBML rồi quên đồng bộ code.

Table universe {
  ticker varchar [pk]
  yahoo_symbol varchar
  company_name varchar
  first_trading_date date
  exchange_current varchar
  exchange_history varchar
  data_source varchar [note: 'dnse | yahoo | vnstock']
  notes varchar

  Note: 'configs/universe.yaml — 8 mã (phạm vi đã khóa). Không phải artifact pipeline, chỉ để các bảng khác FK vào ticker.'
}

Table returns {
  date date
  ticker varchar [ref: > universe.ticker]
  open float
  high float
  low float
  close float
  adjusted_close float [note: '> 0']
  volume int [note: '>= 0']
  source_id varchar
  data_version varchar
  quality_flag varchar
  turnover_value float
  prev_adj float [note: 'NaN ở ngày đầu mỗi ticker — ĐÚNG Ý, không forward-fill']
  simple_return float
  log_return float
  split varchar [note: 'train | validation | test | out_of_scope']

  indexes {
    (date, ticker) [pk]
  }

  Note: 'data/processed/returns.parquet — schemas/returns.py. Đối chiếu code thật (packages/data), CLAUDE.md quy tắc 3.'
}

Table market_features {
  date date [pk]
  open float [note: 'required=False — KHÔNG tồn tại (không phải NaN) ở nhánh custom-composite']
  high float [note: 'required=False']
  low float [note: 'required=False']
  close float
  volume float
  source varchar [note: 'vnstock_VCI_VNINDEX | custom_composite_ew']
  market_log_return float
  market_simple_return float
  realized_vol_20d float
  rolling_max_252 float
  drawdown float
  liquidity_20d float
  split varchar [note: 'train | validation | test | out_of_scope']

  Note: 'data/processed/market_features.parquet — schemas/features.py. 1 dòng/ngày mức thị trường, không có ticker.'
}

Table eligibility_daily {
  date date
  ticker varchar [ref: > universe.ticker]
  eligible_flag bool
  reason_code varchar [note: 'OK | NOT_LISTED_AT_DATE | INSUFFICIENT_HISTORY | LOW_COVERAGE | SUSPENDED_OR_NO_DATA | LOW_LIQUIDITY']
  sessions_available int
  coverage_pct float
  avg_turnover_20d float

  indexes {
    (date, ticker) [pk]
  }

  Note: 'data/processed/eligibility_daily.parquet — schemas/eligibility.py (file mới, chưa có trong data_contracts.md gốc).'
}

Table regime_daily {
  date date [pk]
  state_id int [note: 'HMM state thô 0/1/2 — CHỈ để trace, KHÔNG suy ra tên (CLAUDE.md quy tắc 7)']
  regime varchar [note: 'normal | volatile | stress — gán THEO THỐNG KÊ']
  prob_normal float
  prob_volatile float
  prob_stress float
  model_version varchar
  seed int

  Note: 'artifacts/.../regime/regime_daily.parquet — schemas/regime.py. SPEC ĐI TRƯỚC, packages/ai chưa implement.'
}

Table scenario_run {
  id integer [pk, increment]
  seed int
  regime_conditioned_on varchar [note: 'giá trị regime_daily.regime tại ngày sinh kịch bản']
  block_length int
  num_scenarios int [note: '500 (phạm vi đã khóa)']
  horizon_days int [note: '20 (phạm vi đã khóa)']
  n_assets int [note: '8 (phạm vi đã khóa)']
  validation_mean float
  validation_std float
  validation_tail_coverage float

  Note: 'Sidecar metadata của stress_scenarios.npz. Tensor (500,20,8) KHÔNG phải bảng quan hệ — chỉ metadata vẽ được ở đây. schemas/scenarios.py::ScenarioMetadata. SPEC ĐI TRƯỚC.'
}

Table baseline_risk {
  id integer [pk, increment]
  var_0 float
  cvar_0 float
  alpha float [note: '0.95']
  portfolio_weights json [note: 'ticker -> weight, tổng = 1.0']

  Note: 'baseline_risk.json — chỉ tiêu TRƯỚC khi áp dụng hành động. schemas/risk.py::BaselineRisk. SPEC ĐI TRƯỚC.'
}

Table action {
  action_id int [pk]
  ticker varchar [ref: > universe.ticker]
  action_type varchar [note: 'giảm 20% vị thế -> tiền mặt (phạm vi đã khóa, duy nhất 1 mức)']

  Note: '8 hành động ứng với 8 mã trong universe — packages/risk/actions.py. SPEC ĐI TRƯỚC.'
}

Table action_effects {
  action_id int [pk, ref: - action.action_id]
  g float [note: 'g_i = CVaR_0 - CVaR_i']
  c float [note: 'transaction cost, >= 0']

  Note: 'action_effects.csv — schemas/risk.py::ActionEffectsSchema. SPEC ĐI TRƯỚC.'
}

Table pairwise_effects {
  action_i int [ref: > action.action_id]
  action_j int [ref: > action.action_id]
  C_ij float [note: 'C_ij = g_i + g_j - R_ij']

  indexes {
    (action_i, action_j) [pk]
  }

  Note: 'pairwise_effects.csv — schemas/risk.py::PairwiseEffectsSchema. SPEC ĐI TRƯỚC.'
}

Table qaoa_result {
  id integer [pk, increment]
  bitstring varchar [note: '8 bit, đúng K=3 bit=1']
  k_actions int
  requested_solver varchar [note: 'exact | qaoa | classical']
  actual_solver varchar [note: 'có thể khác requested nếu fallback']
  exact_energy float
  optimality_gap float
  feasibility_rate float
  true_cvar_before float [note: 'từ qshield_risk.evaluate — KHÔNG phải objective value']
  true_cvar_after float
  shots int
  backend varchar
  runtime_seconds float

  Note: 'qaoa_result.json — schemas/optimization.py::QaoaResult. SPEC ĐI TRƯỚC, packages/quantum chưa implement.'
}

Table qaoa_seed_energy {
  qaoa_result_id integer [ref: > qaoa_result.id]
  seed int
  energy float

  indexes {
    (qaoa_result_id, seed) [pk]
  }

  Note: 'qaoa_energy_by_seed — tối thiểu 10 seed, KHÔNG chỉ seed tốt nhất (docs/limitations.md §4).'
}

Table qaoa_chosen_action {
  qaoa_result_id integer [ref: > qaoa_result.id]
  action_id int [ref: > action.action_id]

  indexes {
    (qaoa_result_id, action_id) [pk]
  }

  Note: 'chosen_actions — K=3 hành động được QAOA/exact chọn.'
}
